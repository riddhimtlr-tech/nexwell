# Copy to .env for local dev. On Render, set these under Environment instead.
DATABASE_URL=postgres://user:password@host:5432/nexwell
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://your-app.vercel.app
TIMEZONE=Asia/Kolkata
# Optional (Google Health):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-render-app.onrender.com/api/health/oauth2callback
